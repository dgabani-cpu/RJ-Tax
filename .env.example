# TaxNexus (GST Web) - Environment Variables Example
# Copy this file to .env locally or add these in Vercel Dashboard -> Settings -> Environment Variables

# PostgreSQL Database Connection String (Works with Vercel Postgres, Supabase, Neon, Railway)
DATABASE_URL="postgresql://postgres:password@localhost:5432/taxnexus?sslmode=require"

# Direct URL for Supabase / Neon connection pooling (Optional, fallback to DATABASE_URL)
DIRECT_URL="postgresql://postgres:password@localhost:5432/taxnexus?sslmode=require"

# Next.js Environment
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENVIRONMENT="production"
